if ENABLE_OPX

OPX_REGRESSION_SRCS = prov/opx/src/main.c \
                      prov/opx/src/sizes.c \
                      prov/opx/src/sel.c \
                      prov/opx/src/opx_thresholds.c \
                      prov/opx/src/opx_thresholds.h \
                      prov/opx/src/opx_regression.h

bin_PROGRAMS += prov/opx/src/opx_regression

if HAVE_CUDA
AM_CFLAGS += -DUSE_CUDA
endif

if HAVE_ROCR
AM_CFLAGS += -DUSE_ROCM
endif

if HAVE_HMEM
AM_CFLAGS += -DUSE_HMEM
endif

prov_opx_src_opx_regression_SOURCES = $(OPX_REGRESSION_SRCS)
prov_opx_src_opx_regression_LDADD = libfabtests.la

endif ENABLE_OPX
